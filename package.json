{
  "name": "cheddar",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun test",
    "dev": "bun run --filter @cheddar/web dev",
    "build": "bun run --filter @cheddar/web build",
    "seed:demo": "bun scripts/seed-demo.ts",
    "db:migrate": "bun scripts/migrate.ts"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "embedded-postgres",
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ],
  "devDependencies": {
    "@cheddar/db": "workspace:*",
    "@cheddar/exchange": "workspace:*",
    "@types/bun": "^1.4.5"
  }
}

# Copy to .env.local at the repo root (never commit it).

# Public URL of the web app. OAuth redirect URIs are APP_URL + the paths below.
APP_URL=http://localhost:3000

# Hack Club Auth (https://auth.hackclub.com) - redirect URI: APP_URL/api/auth/callback/hackclub
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Hackatime OAuth (https://hackatime.hackclub.com) - redirect URI: APP_URL/api/hackatime/callback
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# Postgres connection string. Leave empty for a local PGlite database in .data/pglite.
DATABASE_URL=

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Bearer secret for GET /api/cron/churn (Vercel Cron sends it automatically).
CRON_SECRET=

# Slack bot token (xoxb-…) used for DMs and the channel resync.
SLACK_BOT_TOKEN=

# Channel the cron resync invites every active user to (defaults to the Cheddar channel).
SLACK_SYNC_CHANNEL_ID=C0CH8NW4UNP

# Comma-separated Slack IDs that become Cheesemongers when they log in.
CHEDDAR_CHEESEMONGER_SLACK_IDS=

# Comma-separated Slack IDs that become super admins (users, Mouse funders, logs, health) when they log in.
CHEDDAR_SUPER_ADMIN_SLACK_IDS=

# Allow a Cheesemonger to review their own proposals/settlements (handy while there's only one).
CHEDDAR_ALLOW_SELF_REVIEW=false

# Automatic Churn inside the server process, in minutes (default 15). Set 0 on serverless
# hosts like Vercel and call /api/cron/churn on a schedule instead.
CHURN_INTERVAL_MINUTES=15
